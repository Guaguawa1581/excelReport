{
  "code": "IPQC_EXT_INSPECT",
  "name": "外部檢驗紀錄表",
  "templateFile": "sample_inspection.xlsx",
  "dataSource": {
    "url": "https://localhost:44314/api/v2/QMS/DataCenter/Reports/SupplierInsRecords?page=1&limit=10&8.0=20260703133329170",
    "method": "GET",
    "headers": {
      "authorization": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..NS98U7xelZbRHBWcLDFBPjj9J1Uipq0gY4U0Bslflso"
    },
    "timeoutSec": 30
  },
  "parameters": [],
  "mapping": {
    "root": "$.records[0]",
    "fields": {
      "docNo": "$.itemOrderNo",
      "seqNo": "$.sid",
      "sourceDoc": "$.sourceOrderNo",
      "partNo": "$.productNo",
      "qcModule": "$.moduleName",
      "processCode": "$.processNo",
      "qty": "$.quantity",
      "partName": "$.productName",
      "processName": "$.processName",
      "spec": "$.productSpec",
      "inspectPoint": "$.operationAreaNo",
      "vendor": "$.companyName",
      "remark": "$.eqpEntityNo",
      "date": "$.prodouctEndDateTime",
      "inspectRemark": "$.prodouctResultNotation",
      "inspectSpec": "$.stdName"
    },
    "collections": [
      {
        "name": "items",
        "path": "$.tasks[0].items",
        "columns": {
          "seq": "$.insPoint",
          "itemName": "$.itemTypeName",
          "point": "$.insPoint",
          "std": "$.stdValue",
          "lower": "$.lowLimit",
          "upper": "$.upLimit",
          "gauge": "$.toolTypeName",
          "result": "$.itemResultName"
        },
        "spread": {
          "from": "$.samples[*].measuredValue",
          "prefix": "v",
          "max": 13
        }
      }
    ],
    "images": {
      "photo": { "path": "https://i.imgur.com/y0B0aul.jpeg", "sourceType": "url" }
    }
  }
}

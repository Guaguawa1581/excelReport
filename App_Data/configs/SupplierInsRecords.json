      "sourceDoc": "$.companyNo",
      "partNo": "$.companyNo",
      "qcModule": "$.companyNo",
      "processCode": "$.companyNo",
      "partName": "$.companyNo",
      "spec": "$.companyNo",
      "inspectPoint": "$.companyNo",
      "vendor": "$.companyNo",
      "date": "$.companyNo",

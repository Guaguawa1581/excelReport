@model ReportConfigEditViewModel
@{
    ViewData["Title"] = Model.IsNew ? "新增報表設定" : $"編輯報表設定 - {Model.OriginalCode}";
}

<h1 class="mb-4">@(Model.IsNew ? "新增報表設定" : $"編輯報表設定：{Model.OriginalCode}")</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<form method="post" asp-action="Edit" id="editForm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="originalCode" value="@Model.OriginalCode" />
    <input type="hidden" name="configJson" id="configJson" />

    <div class="card mb-3">
        <div class="card-header">基本資訊</div>
        <div class="card-body row g-3">
            <div class="col-md-4">
                <label class="form-label">設定代碼 (code) *</label>
                <input type="text" class="form-control" id="f-code" required @(Model.IsNew ? "" : "readonly") />
                <div class="form-text">英數字與底線，作為檔名與識別代碼，例如 IPQC_EXT_INSPECT</div>
            </div>
            <div class="col-md-8">
                <label class="form-label">報表名稱 *</label>
                <input type="text" class="form-control" id="f-name" required />
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">資料來源</div>
        <div class="card-body row g-3">
            <div class="col-md-4">
                <label class="form-label">資料來源類型</label>
                <select class="form-select" id="f-sourceType">
                    <option value="url">API URL</option>
                    <option value="paste">貼上 JSON 物件（測試用）</option>
                </select>
            </div>
            <div id="sourceUrlFields" class="col-12 row g-3">
                <div class="col-md-7">
                    <label class="form-label">資料來源 URL（可用 {paramKey} 佔位符，例如 {docNo}）</label>
                    <input type="text" class="form-control" id="f-url" placeholder="http://localhost:5000/api/mock/inspection/{docNo}" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Method</label>
                    <select class="form-select" id="f-method">
                        <option>GET</option>
                        <option>POST</option>
                        <option>PUT</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">逾時秒數</label>
                    <input type="number" class="form-control" id="f-timeout" value="30" min="1" />
                </div>
                <div class="col-12">
                    <label class="form-label">自訂 Headers</label>
                    <div id="headerRows"></div>
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="addHeaderBtn">+ 新增 Header</button>
                </div>
            </div>
            <div id="sourcePasteFields" class="col-12" style="display:none">
                <label class="form-label">貼上 JSON 物件</label>
                <textarea class="form-control" id="f-staticJson" rows="10" style="font-family:monospace" placeholder='{&#10;  "data": { }&#10;}'></textarea>
                <div class="form-text">此模式不會呼叫任何 API，直接使用這裡貼上的內容做為資料來源，僅供測試映射設定用。</div>
                <div id="staticJsonError" class="text-danger small mt-1"></div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">參數定義（供 /Report/Index 動態產生輸入欄位）</div>
        <div class="card-body">
            <div id="paramRows"></div>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="addParamBtn">+ 新增參數</button>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">測試連線</div>
        <div class="card-body">
            <div class="mb-2 text-muted small">依上方「參數定義」帶入測試值，代打一次資料來源 API，並顯示原始回應內容。</div>
            <div id="testParamRows" class="row g-2 mb-2"></div>
            <button type="button" class="btn btn-outline-primary" id="testConnectionBtn">測試連線</button>
            <pre id="testConnectionResult" class="bg-light p-2 mt-2" style="max-height:300px; overflow:auto;"></pre>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">主報表設定</div>
        <div class="card-body">
            <h6>範本檔案</h6>
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label">選擇既有範本</label>
                    <select class="form-select" id="f-templateSelect">
                        <option value="">-- 請選擇 --</option>
                        @foreach (var t in Model.AvailableTemplates)
                        {
                            <option value="@t">@t</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">或上傳新範本 (.xlsx)</label>
                    <input type="file" class="form-control" id="f-templateUpload" accept=".xlsx" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">要讀取的工作表</label>
                    <select class="form-select" id="f-templateSheet"></select>
                </div>
                <div class="col-md-2">
                    <span class="badge text-bg-info" id="templateFileBadge">尚未選擇</span>
                    <a id="downloadTemplateLink" class="btn btn-sm btn-outline-secondary mt-1" style="display:none" target="_blank">下載範本</a>
                </div>
            </div>
            <div id="uploadError" class="text-danger mt-2"></div>
            <div class="mt-3">
                <strong>範本標記掃描結果：</strong>
                <div id="scanResultView" class="small text-muted">尚未掃描</div>
            </div>

            <hr class="my-4" />

            <h6>映射設定</h6>
            <div class="mb-3">
                <label class="form-label">根節點 JSONPath (root)</label>
                <input type="text" class="form-control" id="f-root" value="$.data" style="max-width:300px" />
            </div>
            <h6>一般欄位</h6>
            <div class="text-muted small mb-2">JSONPath 留空的話，預設會用 <code>$.標記名稱</code>（例如 <code>{{docNo}}</code> 預設對應 <code>$.docNo</code>）。</div>
            <table class="table table-sm" id="fieldMappingTable">
                <thead><tr><th style="width:220px">範本標記</th><th>JSONPath</th></tr></thead>
                <tbody id="fieldMappingBody"></tbody>
            </table>

            <h6 class="mt-4">集合欄位</h6>
            <div id="collectionMappingArea"></div>

            <h6 class="mt-4">圖片欄位</h6>
            <div class="text-muted small mb-2">範本中 <code>[[標記]]</code> 這種方括號語法（與一般 <code>{{標記}}</code> 不同）。填 <code>$</code> 開頭的 JSONPath 會從資料來源取值（值可以是圖片 URL 或 base64 內容）；不是 <code>$</code> 開頭則直接當成固定值使用（例如寫死一個圖片 URL）。留白或抓取失敗時該張圖片會直接略過，不會擋下儲存或報表產生。</div>
            <table class="table table-sm" id="imageMappingTable">
                <thead><tr><th style="width:220px">範本標記</th><th>JSONPath</th><th style="width:140px">來源型別</th></tr></thead>
                <tbody id="imageMappingBody"></tbody>
            </table>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">子報表（產生報表時依序接在主報表後面）</div>
        <div class="card-body">
            <div class="text-muted small mb-3">
                每個子報表是獨立的一份 xlsx 範本（例如 tasks[].items[] 這種巢狀資料的「一個 task 一個表頭 + 明細列」區塊）。
                產生報表時，會對「父層陣列」的每一個元素各自渲染一次整份子範本、依序接在主報表（以及前一個子報表）後面，
                子範本內要有兩個集合標記：父層集合（例如 <code>{{tasks.xxx}}</code>，每次渲染剛好展開一列當表頭）與
                子層集合（例如 <code>{{items.xxx}}</code>，展開該父層元素底下的明細列）。
            </div>
            <div id="subReportsArea"></div>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="addSubReportBtn">+ 新增子報表</button>
        </div>
    </div>

    <button type="submit" class="btn btn-primary btn-lg">儲存設定</button>
    <a asp-action="Index" class="btn btn-secondary btn-lg">取消</a>
</form>

@section Scripts {
    <script>
        const initialConfig = @Html.Raw(Json.Serialize(Model.Config));
        let currentScanResult = @Html.Raw(Json.Serialize(Model.ScanResult));
        const availableTemplates = @Html.Raw(Json.Serialize(Model.AvailableTemplates));
        const sheetNames = @Html.Raw(Json.Serialize(Model.SheetNames));
        const subReportScans = @Html.Raw(Json.Serialize(Model.SubReportScans));
        const subReportSheetNames = @Html.Raw(Json.Serialize(Model.SubReportSheetNames));

        function el(tag, cls, html) {
            const e = document.createElement(tag);
            if (cls) e.className = cls;
            if (html !== undefined) e.innerHTML = html;
            return e;
        }

        // ---------- Headers ----------
        function addHeaderRow(key = '', value = '') {
            const row = el('div', 'row g-2 mb-2 header-row');
            const c1 = el('div', 'col-md-4'); const i1 = el('input', 'form-control header-key'); i1.placeholder = 'Header 名稱'; i1.value = key;
            const c2 = el('div', 'col-md-6'); const i2 = el('input', 'form-control header-value'); i2.placeholder = 'Header 值'; i2.value = value;
            const c3 = el('div', 'col-md-2'); const btn = el('button', 'btn btn-outline-danger', '移除'); btn.type = 'button';
            btn.onclick = () => row.remove();
            c1.appendChild(i1); c2.appendChild(i2); c3.appendChild(btn);
            row.appendChild(c1); row.appendChild(c2); row.appendChild(c3);
            document.getElementById('headerRows').appendChild(row);
        }
        document.getElementById('addHeaderBtn').addEventListener('click', () => addHeaderRow());

        // ---------- Data source type toggle ----------
        function updateSourceTypeVisibility() {
            const isPaste = document.getElementById('f-sourceType').value === 'paste';
            document.getElementById('sourceUrlFields').style.display = isPaste ? 'none' : '';
            document.getElementById('sourcePasteFields').style.display = isPaste ? '' : 'none';
        }
        document.getElementById('f-sourceType').addEventListener('change', updateSourceTypeVisibility);

        // ---------- Parameters ----------
        function addParamRow(key = '', label = '', type = 'string', required = true) {
            const row = el('div', 'row g-2 mb-2 param-row');
            const c1 = el('div', 'col-md-3'); const i1 = el('input', 'form-control param-key'); i1.placeholder = 'key (例如 docNo)'; i1.value = key;
            const c2 = el('div', 'col-md-3'); const i2 = el('input', 'form-control param-label'); i2.placeholder = '顯示名稱'; i2.value = label;
            const c3 = el('div', 'col-md-2'); const i3 = el('select', 'form-select param-type');
            ['string', 'number', 'date'].forEach(t => { const o = el('option'); o.value = t; o.textContent = t; if (t === type) o.selected = true; i3.appendChild(o); });
            const c4 = el('div', 'col-md-2 form-check mt-2'); const i4 = el('input', 'form-check-input param-required'); i4.type = 'checkbox'; i4.checked = required;
            const lbl = el('label', 'form-check-label', '必填'); c4.appendChild(i4); c4.appendChild(lbl);
            const c5 = el('div', 'col-md-2'); const btn = el('button', 'btn btn-outline-danger', '移除'); btn.type = 'button';
            btn.onclick = () => { row.remove(); renderTestParamRows(); };
            c5.appendChild(btn);
            [c1, c2, c3, c4, c5].forEach(c => row.appendChild(c));
            c1.appendChild(i1); c2.appendChild(i2); c3.appendChild(i3);
            document.getElementById('paramRows').appendChild(row);
            i1.addEventListener('input', renderTestParamRows);
            renderTestParamRows();
        }
        document.getElementById('addParamBtn').addEventListener('click', () => addParamRow());

        function getParameters() {
            return Array.from(document.querySelectorAll('.param-row')).map(row => ({
                key: row.querySelector('.param-key').value.trim(),
                label: row.querySelector('.param-label').value.trim(),
                type: row.querySelector('.param-type').value,
                required: row.querySelector('.param-required').checked
            })).filter(p => p.key);
        }

        function renderTestParamRows() {
            const container = document.getElementById('testParamRows');
            const existing = {};
            container.querySelectorAll('input').forEach(i => existing[i.dataset.key] = i.value);
            container.innerHTML = '';
            getParameters().forEach(p => {
                const col = el('div', 'col-md-3');
                const lbl = el('label', 'form-label small', p.label || p.key);
                const input = el('input', 'form-control test-param-value');
                input.dataset.key = p.key;
                input.value = existing[p.key] || (p.key === 'docNo' ? '0040' : '');
                col.appendChild(lbl); col.appendChild(input);
                container.appendChild(col);
            });
        }

        // ---------- Template scan / mapping ----------
        function markerHtml(text) { return '<code>{{' + text + '}}</code>'; }

        function imageMarkerHtml(text) { return '<code>[[' + text + ']]</code>'; }

        function renderScanResult(scan) {
            const view = document.getElementById('scanResultView');
            const hasAny = scan && ((scan.fields || []).length > 0 || (scan.collections || []).length > 0 || (scan.imageFields || []).length > 0);
            if (!hasAny) {
                view.textContent = '此範本內找不到任何 {{}} 或 [[]] 標記';
                return;
            }
            let html = '欄位：' + (scan.fields || []).map(markerHtml).join(' ');
            (scan.collections || []).forEach(c => {
                html += '<br/>集合 ' + c.name + '：' + c.columns.map(col => markerHtml(c.name + '.' + col)).join(' ');
            });
            if ((scan.imageFields || []).length > 0) {
                html += '<br/>圖片：' + scan.imageFields.map(imageMarkerHtml).join(' ');
            }
            view.innerHTML = html;
        }

        function renderFieldMapping(scan, existingFields) {
            const body = document.getElementById('fieldMappingBody');
            body.innerHTML = '';
            (scan?.fields || []).forEach(f => {
                const existing = existingFields && existingFields[f];
                const tr = el('tr');
                const td1 = el('td'); td1.innerHTML = markerHtml(f);
                const td2 = el('td'); const input = el('input', 'form-control field-mapping-input'); input.dataset.field = f;
                input.value = existing || '';
                input.placeholder = '$.' + f + '（留空預設用這個）';
                td2.appendChild(input);
                tr.appendChild(td1); tr.appendChild(td2);
                body.appendChild(tr);
            });
        }

        function isSpreadCovered(columnName, spread) {
            if (!spread || !spread.prefix) return false;
            if (!columnName.startsWith(spread.prefix)) return false;
            const rest = columnName.substring(spread.prefix.length);
            const n = parseInt(rest, 10);
            return !isNaN(n) && n >= 1 && n <= (spread.max || 0);
        }

        function renderCollectionMapping(scan, existingCollections) {
            const area = document.getElementById('collectionMappingArea');
            area.innerHTML = '';
            (scan?.collections || []).forEach(c => {
                const existing = (existingCollections || []).find(ec => ec.name === c.name) || {};
                const existingSpread = existing.spread || { from: '$.values', prefix: 'v', max: 13 };

                const box = el('div', 'border rounded p-3 mb-3 collection-box');
                box.dataset.name = c.name;
                box.appendChild(el('h6', '', '集合：' + c.name));

                const pathRow = el('div', 'row g-2 mb-2');
                const pathCol = el('div', 'col-md-6');
                pathCol.appendChild(el('label', 'form-label small', '陣列來源路徑 (path)'));
                const pathInput = el('input', 'form-control collection-path'); pathInput.value = existing.path || '';
                pathInput.placeholder = '$.details';
                pathCol.appendChild(pathInput);
                pathRow.appendChild(pathCol);
                box.appendChild(pathRow);

                const spreadRow = el('div', 'row g-2 mb-2');
                const s1 = el('div', 'col-md-4'); s1.appendChild(el('label', 'form-label small', 'spread 陣列來源路徑 (相對於每筆項目)'));
                const spreadFrom = el('input', 'form-control spread-from'); spreadFrom.value = existingSpread.from || ''; spreadFrom.placeholder = '$.values';
                s1.appendChild(spreadFrom);
                const s2 = el('div', 'col-md-3'); s2.appendChild(el('label', 'form-label small', '欄位前綴 (prefix)'));
                const spreadPrefix = el('input', 'form-control spread-prefix'); spreadPrefix.value = existingSpread.prefix || 'v';
                s2.appendChild(spreadPrefix);
                const s3 = el('div', 'col-md-3'); s3.appendChild(el('label', 'form-label small', '最大欄數 (max)'));
                const spreadMax = el('input', 'form-control spread-max'); spreadMax.type = 'number'; spreadMax.value = existingSpread.max || 13;
                s3.appendChild(spreadMax);
                [s1, s2, s3].forEach(x => spreadRow.appendChild(x));
                box.appendChild(spreadRow);

                const colTable = el('table', 'table table-sm');
                const thead = el('thead', '', '<tr><th style="width:220px">範本標記</th><th>JSONPath（相對於每筆項目，留空預設用標記名稱）</th></tr>');
                const tbody = el('tbody');
                colTable.appendChild(thead); colTable.appendChild(tbody);
                box.appendChild(colTable);

                function renderColumns() {
                    tbody.innerHTML = '';
                    const spread = { prefix: spreadPrefix.value, max: parseInt(spreadMax.value, 10) || 0 };
                    c.columns.forEach(col => {
                        const covered = isSpreadCovered(col, spread);
                        const existingCol = existing.columns && existing.columns[col];
                        const tr = el('tr');
                        const td1 = el('td'); td1.innerHTML = markerHtml(c.name + '.' + col);
                        const td2 = el('td');
                        if (covered) {
                            td2.innerHTML = '<span class="text-muted small">由 spread 設定自動產生，無需個別映射</span>';
                        } else {
                            const input = el('input', 'form-control collection-column-input'); input.dataset.column = col;
                            input.value = existingCol || '';
                            input.placeholder = '$.' + col;
                            td2.appendChild(input);
                        }
                        tr.appendChild(td1); tr.appendChild(td2);
                        tbody.appendChild(tr);
                    });
                }
                renderColumns();
                [spreadPrefix, spreadMax].forEach(i => i.addEventListener('input', renderColumns));

                area.appendChild(box);
            });
        }

        function makeImageSourceTypeSelect(cls, currentType) {
            const select = el('select', 'form-select ' + cls);
            ['auto', 'url', 'base64'].forEach(t => {
                const o = el('option', '', t);
                o.value = t;
                if ((currentType || 'auto') === t) o.selected = true;
                select.appendChild(o);
            });
            return select;
        }

        function renderImageMapping(scan, existingImages) {
            const body = document.getElementById('imageMappingBody');
            body.innerHTML = '';
            (scan?.imageFields || []).forEach(f => {
                const existing = existingImages && existingImages[f];
                const tr = el('tr');
                const td1 = el('td'); td1.innerHTML = imageMarkerHtml(f);
                const td2 = el('td'); const input = el('input', 'form-control image-mapping-input'); input.dataset.field = f;
                input.value = (existing && existing.path) || '';
                input.placeholder = '$.' + f + ' 或直接填固定圖片 URL';
                td2.appendChild(input);
                const td3 = el('td'); const typeSelect = makeImageSourceTypeSelect('image-mapping-type', existing && existing.sourceType); typeSelect.dataset.field = f;
                td3.appendChild(typeSelect);
                tr.appendChild(td1); tr.appendChild(td2); tr.appendChild(td3);
                body.appendChild(tr);
            });
        }

        // ---------- Sheet select ----------
        function populateSheetSelect(select, names, selectedValue) {
            select.innerHTML = '';
            (names || []).forEach((name, idx) => {
                const o = el('option', '', `(${idx}) ${name}`);
                o.value = String(idx);
                if (String(selectedValue ?? '0') === String(idx)) o.selected = true;
                select.appendChild(o);
            });
        }

        function applyScanResult(scan, existingMapping) {
            currentScanResult = scan;
            renderScanResult(scan);
            renderFieldMapping(scan, existingMapping?.fields);
            renderCollectionMapping(scan, existingMapping?.collections);
            renderImageMapping(scan, existingMapping?.images);
        }

        // ---------- Sub reports ----------
        function buildMappingRows(tbody, columns, existingColumnMap, markerPrefix, spreadGetter, inputClass) {
            tbody.innerHTML = '';
            columns.forEach(col => {
                const covered = spreadGetter ? isSpreadCovered(col, spreadGetter()) : false;
                const existingVal = existingColumnMap && existingColumnMap[col];
                const tr = el('tr');
                const td1 = el('td'); td1.innerHTML = markerHtml(markerPrefix + '.' + col);
                const td2 = el('td');
                if (covered) {
                    td2.innerHTML = '<span class="text-muted small">由 spread 設定自動產生，無需個別映射</span>';
                } else if (col === 'seq') {
                    td2.innerHTML = '<span class="text-muted small">保留欄位，自動填入序號（1, 2, 3...），不需映射</span>';
                } else {
                    const input = el('input', 'form-control ' + inputClass); input.dataset.column = col;
                    input.value = existingVal || '';
                    input.placeholder = '$.' + col;
                    td2.appendChild(input);
                }
                tr.appendChild(td1); tr.appendChild(td2);
                tbody.appendChild(tr);
            });
        }

        function renderSubReportMapping(area, scan, existing) {
            area.innerHTML = '';
            const collections = (scan && scan.collections) || [];
            if (collections.length === 0) {
                area.innerHTML = '<div class="text-muted small">此範本內找不到集合標記（例如 <code>{{tasks.xxx}}</code>），至少需要父層與子層兩個集合。</div>';
                return;
            }

            function defaultPath(name) { return name ? '$.' + name : ''; }

            const selectorRow = el('div', 'row g-3 mb-2');
            const pCol = el('div', 'col-md-6');
            pCol.appendChild(el('label', 'form-label small', '父層集合（表頭，每次渲染只展開一列）'));
            const parentSelect = el('select', 'form-select sr-parent-collection');
            collections.forEach(c => { const o = el('option', '', c.name); o.value = c.name; parentSelect.appendChild(o); });
            pCol.appendChild(parentSelect);
            const cCol = el('div', 'col-md-6');
            cCol.appendChild(el('label', 'form-label small', '子層集合（明細列）'));
            const childSelect = el('select', 'form-select sr-child-collection');
            collections.forEach(c => { const o = el('option', '', c.name); o.value = c.name; childSelect.appendChild(o); });
            cCol.appendChild(childSelect);
            parentSelect.value = existing.parentCollectionName || collections[0].name;
            childSelect.value = existing.childCollectionName || (collections[1] ? collections[1].name : collections[0].name);
            selectorRow.appendChild(pCol); selectorRow.appendChild(cCol);
            area.appendChild(selectorRow);

            const pathRow = el('div', 'row g-3 mb-2');
            const ppCol = el('div', 'col-md-6');
            ppCol.appendChild(el('label', 'form-label small', '父層陣列路徑（相對 root）'));
            const parentPathInput = el('input', 'form-control sr-parent-path');
            ppCol.appendChild(parentPathInput);
            const cpCol = el('div', 'col-md-6');
            cpCol.appendChild(el('label', 'form-label small', '子層陣列路徑（相對每個父層元素）'));
            const childPathInput = el('input', 'form-control sr-child-path');
            cpCol.appendChild(childPathInput);
            pathRow.appendChild(ppCol); pathRow.appendChild(cpCol);
            area.appendChild(pathRow);

            parentPathInput.value = existing.parentPath || defaultPath(parentSelect.value);
            childPathInput.value = existing.childPath || defaultPath(childSelect.value);

            const parentTableWrap = el('div');
            parentTableWrap.appendChild(el('h6', 'mt-2', '父層欄位（相對每個父層元素）'));
            const parentTable = el('table', 'table table-sm');
            parentTable.appendChild(el('thead', '', '<tr><th style="width:220px">範本標記</th><th>JSONPath（留空預設用標記名稱）</th></tr>'));
            const parentTbody = el('tbody');
            parentTable.appendChild(parentTbody);
            parentTableWrap.appendChild(parentTable);
            area.appendChild(parentTableWrap);

            const spreadRow = el('div', 'row g-2 mb-2');
            const s1 = el('div', 'col-md-4'); s1.appendChild(el('label', 'form-label small', '子層 spread 陣列來源路徑（相對每筆子層元素）'));
            const spreadFrom = el('input', 'form-control sr-spread-from'); spreadFrom.placeholder = '$.samples[*].measuredValue';
            s1.appendChild(spreadFrom);
            const s2 = el('div', 'col-md-3'); s2.appendChild(el('label', 'form-label small', '欄位前綴 (prefix)'));
            const spreadPrefix = el('input', 'form-control sr-spread-prefix');
            s2.appendChild(spreadPrefix);
            const s3 = el('div', 'col-md-3'); s3.appendChild(el('label', 'form-label small', '最大欄數 (max)'));
            const spreadMax = el('input', 'form-control sr-spread-max'); spreadMax.type = 'number';
            s3.appendChild(spreadMax);
            [s1, s2, s3].forEach(x => spreadRow.appendChild(x));

            const existingSpread = existing.childSpread || {};
            spreadFrom.value = existingSpread.from || '';
            spreadPrefix.value = existingSpread.prefix || 'v';
            spreadMax.value = existingSpread.max || 13;

            const childTableWrap = el('div');
            childTableWrap.appendChild(el('h6', 'mt-3', '子層欄位（相對每個子層元素）'));
            childTableWrap.appendChild(spreadRow);
            const childTable = el('table', 'table table-sm');
            childTable.appendChild(el('thead', '', '<tr><th style="width:220px">範本標記</th><th>JSONPath（留空預設用標記名稱）</th></tr>'));
            const childTbody = el('tbody');
            childTable.appendChild(childTbody);
            childTableWrap.appendChild(childTable);
            area.appendChild(childTableWrap);

            function renderParentColumns() {
                const cols = (collections.find(c => c.name === parentSelect.value) || {}).columns || [];
                buildMappingRows(parentTbody, cols, existing.parentColumns, parentSelect.value, null, 'sr-parent-column-input');
            }
            function renderChildColumns() {
                const cols = (collections.find(c => c.name === childSelect.value) || {}).columns || [];
                const spreadGetter = () => ({ prefix: spreadPrefix.value, max: parseInt(spreadMax.value, 10) || 0 });
                buildMappingRows(childTbody, cols, existing.childColumns, childSelect.value, spreadGetter, 'sr-child-column-input');
            }

            parentSelect.addEventListener('change', () => { parentPathInput.value = defaultPath(parentSelect.value); renderParentColumns(); });
            childSelect.addEventListener('change', () => { childPathInput.value = defaultPath(childSelect.value); renderChildColumns(); });
            [spreadPrefix, spreadMax].forEach(i => i.addEventListener('input', renderChildColumns));

            renderParentColumns();
            renderChildColumns();
        }

        function createSubReportCard(existing) {
            existing = existing || {};
            const card = el('div', 'border rounded p-3 mb-3 subreport-card');

            const headerRow = el('div', 'row g-3 align-items-end mb-2');
            const c1 = el('div', 'col-md-3');
            c1.appendChild(el('label', 'form-label', '選擇既有範本'));
            const select = el('select', 'form-select sr-template-select');
            select.appendChild(el('option', '', '-- 請選擇 --'));
            availableTemplates.forEach(t => {
                const o = el('option', '', t); o.value = t;
                if (existing.templateFile === t) o.selected = true;
                select.appendChild(o);
            });
            c1.appendChild(select);

            const c2 = el('div', 'col-md-3');
            c2.appendChild(el('label', 'form-label', '或上傳新範本 (.xlsx)'));
            const upload = el('input', 'form-control sr-template-upload'); upload.type = 'file'; upload.accept = '.xlsx';
            c2.appendChild(upload);

            const c3 = el('div', 'col-md-2');
            c3.appendChild(el('label', 'form-label', '要讀取的工作表'));
            const sheetSelect = el('select', 'form-select sr-template-sheet');
            c3.appendChild(sheetSelect);

            const c4 = el('div', 'col-md-3');
            c4.appendChild(el('label', 'form-label d-block', '&nbsp;'));
            const badge = el('span', 'badge text-bg-info sr-template-badge', existing.templateFile || '尚未選擇');
            c4.appendChild(badge);
            const downloadLink = el('a', 'btn btn-sm btn-outline-secondary mt-1 sr-download-link', '下載範本');
            downloadLink.target = '_blank';
            setLinkTarget(downloadLink, existing.templateFile);
            c4.appendChild(downloadLink);

            const c5 = el('div', 'col-md-1');
            const removeBtn = el('button', 'btn btn-outline-danger btn-sm', '移除');
            removeBtn.type = 'button';
            removeBtn.onclick = () => card.remove();
            c5.appendChild(removeBtn);

            [c1, c2, c3, c4, c5].forEach(c => headerRow.appendChild(c));
            card.appendChild(headerRow);

            const errorDiv = el('div', 'text-danger small mb-2 sr-error');
            card.appendChild(errorDiv);

            const mappingArea = el('div', 'sr-mapping-area');
            card.appendChild(mappingArea);

            function applyScan(scan, names, selectedSheet) {
                populateSheetSelect(sheetSelect, names, selectedSheet);
                renderSubReportMapping(mappingArea, scan, existing);
            }

            select.addEventListener('change', async () => {
                const fileName = select.value;
                if (!fileName) return;
                badge.textContent = fileName;
                setLinkTarget(downloadLink, fileName);
                errorDiv.textContent = '';
                try {
                    const resp = await fetch('@Url.Action("ScanTemplate", "ReportConfig")?fileName=' + encodeURIComponent(fileName));
                    const json = await resp.json();
                    if (!resp.ok) { errorDiv.textContent = json.message || '掃描失敗'; return; }
                    applyScan(json.scanResult, json.sheetNames, '0');
                } catch (e) { errorDiv.textContent = '掃描失敗：' + e; }
            });

            upload.addEventListener('change', async () => {
                const file = upload.files[0];
                if (!file) return;
                const formData = new FormData();
                formData.append('file', file);
                errorDiv.textContent = '';
                try {
                    const resp = await fetch('@Url.Action("UploadTemplate", "ReportConfig")', { method: 'POST', body: formData });
                    const json = await resp.json();
                    if (!resp.ok) { errorDiv.textContent = json.message || '上傳失敗'; return; }
                    badge.textContent = json.fileName;
                    setLinkTarget(downloadLink, json.fileName);
                    select.value = '';
                    applyScan(json.scanResult, json.sheetNames, '0');
                } catch (e) { errorDiv.textContent = '上傳失敗：' + e; }
            });

            sheetSelect.addEventListener('change', async () => {
                const fileName = badge.textContent.trim();
                if (!fileName || fileName === '尚未選擇') return;
                errorDiv.textContent = '';
                try {
                    const resp = await fetch('@Url.Action("ScanTemplate", "ReportConfig")?fileName=' + encodeURIComponent(fileName) + '&sheet=' + encodeURIComponent(sheetSelect.value));
                    const json = await resp.json();
                    if (!resp.ok) { errorDiv.textContent = json.message || '掃描失敗'; return; }
                    renderSubReportMapping(mappingArea, json.scanResult, existing);
                } catch (e) { errorDiv.textContent = '掃描失敗：' + e; }
            });

            if (existing.templateFile && subReportScans[existing.templateFile]) {
                applyScan(subReportScans[existing.templateFile], subReportSheetNames[existing.templateFile], existing.templateSheet);
            }

            return card;
        }

        document.getElementById('addSubReportBtn').addEventListener('click', () => {
            document.getElementById('subReportsArea').appendChild(createSubReportCard({}));
        });

        function getSubReports() {
            return Array.from(document.querySelectorAll('.subreport-card')).map(card => {
                const parentColumns = {};
                card.querySelectorAll('.sr-parent-column-input').forEach(i => { if (i.value.trim()) parentColumns[i.dataset.column] = i.value.trim(); });
                const childColumns = {};
                card.querySelectorAll('.sr-child-column-input').forEach(i => { if (i.value.trim()) childColumns[i.dataset.column] = i.value.trim(); });
                const spreadFrom = card.querySelector('.sr-spread-from');
                const parentSelect = card.querySelector('.sr-parent-collection');
                const childSelect = card.querySelector('.sr-child-collection');
                const parentPath = card.querySelector('.sr-parent-path');
                const childPath = card.querySelector('.sr-child-path');
                return {
                    templateFile: card.querySelector('.sr-template-badge').textContent.trim(),
                    templateSheet: card.querySelector('.sr-template-sheet').value || '0',
                    parentPath: parentPath ? parentPath.value.trim() : '',
                    parentCollectionName: parentSelect ? parentSelect.value : '',
                    parentColumns: parentColumns,
                    childPath: childPath ? childPath.value.trim() : '',
                    childCollectionName: childSelect ? childSelect.value : '',
                    childColumns: childColumns,
                    childSpread: spreadFrom ? {
                        from: spreadFrom.value.trim(),
                        prefix: card.querySelector('.sr-spread-prefix').value.trim(),
                        max: parseInt(card.querySelector('.sr-spread-max').value, 10) || 0
                    } : null
                };
            }).filter(sr => sr.templateFile && sr.templateFile !== '尚未選擇');
        }

        // ---------- Template download link ----------
        function downloadTemplateUrl(fileName) {
            return '@Url.Action("DownloadTemplate", "ReportConfig")?fileName=' + encodeURIComponent(fileName);
        }

        function updateDownloadLink(fileName) {
            setLinkTarget(document.getElementById('downloadTemplateLink'), fileName);
        }

        function setLinkTarget(link, fileName) {
            if (fileName) {
                link.href = downloadTemplateUrl(fileName);
                link.style.display = 'inline-block';
            } else {
                link.style.display = 'none';
            }
        }

        // ---------- Template upload / select ----------
        document.getElementById('f-templateUpload').addEventListener('change', async (ev) => {
            const file = ev.target.files[0];
            if (!file) return;
            const formData = new FormData();
            formData.append('file', file);
            document.getElementById('uploadError').textContent = '';
            try {
                const resp = await fetch('@Url.Action("UploadTemplate", "ReportConfig")', { method: 'POST', body: formData });
                const json = await resp.json();
                if (!resp.ok) {
                    document.getElementById('uploadError').textContent = json.message || '上傳失敗';
                    return;
                }
                document.getElementById('templateFileBadge').textContent = json.fileName;
                document.getElementById('f-templateSelect').value = '';
                window.__selectedTemplateFile = json.fileName;
                updateDownloadLink(json.fileName);
                populateSheetSelect(document.getElementById('f-templateSheet'), json.sheetNames, '0');
                applyScanResult(json.scanResult, null);
            } catch (e) {
                document.getElementById('uploadError').textContent = '上傳失敗：' + e;
            }
        });

        document.getElementById('f-templateSheet').addEventListener('change', async (ev) => {
            const fileName = window.__selectedTemplateFile;
            if (!fileName) return;
            document.getElementById('uploadError').textContent = '';
            try {
                const resp = await fetch('@Url.Action("ScanTemplate", "ReportConfig")?fileName=' + encodeURIComponent(fileName) + '&sheet=' + encodeURIComponent(ev.target.value));
                const json = await resp.json();
                if (!resp.ok) {
                    document.getElementById('uploadError').textContent = json.message || '掃描失敗';
                    return;
                }
                applyScanResult(json.scanResult, initialConfig.mapping);
            } catch (e) {
                document.getElementById('uploadError').textContent = '掃描失敗：' + e;
            }
        });

        document.getElementById('f-templateSelect').addEventListener('change', (ev) => {
            const fileName = ev.target.value;
            if (!fileName) return;
            const url = new URL(window.location.href);
            url.searchParams.set('code', '@(Model.IsNew ? "new" : Model.OriginalCode)');
            url.searchParams.set('template', fileName);
            window.location.href = url.toString();
        });

        // ---------- Test connection ----------
        document.getElementById('testConnectionBtn').addEventListener('click', async () => {
            const headers = {};
            document.querySelectorAll('.header-row').forEach(row => {
                const k = row.querySelector('.header-key').value.trim();
                const v = row.querySelector('.header-value').value;
                if (k) headers[k] = v;
            });
            const parameters = {};
            document.querySelectorAll('.test-param-value').forEach(i => parameters[i.dataset.key] = i.value);

            const payload = {
                type: document.getElementById('f-sourceType').value,
                url: document.getElementById('f-url').value,
                method: document.getElementById('f-method').value,
                headers: headers,
                parameters: parameters,
                timeoutSec: parseInt(document.getElementById('f-timeout').value, 10) || 30,
                staticJson: document.getElementById('f-staticJson').value
            };

            const resultEl = document.getElementById('testConnectionResult');
            resultEl.textContent = '呼叫中...';
            try {
                const resp = await fetch('@Url.Action("TestConnection", "ReportConfig")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const json = await resp.json();
                if (json.success) {
                    try { resultEl.textContent = JSON.stringify(JSON.parse(json.body), null, 2); }
                    catch { resultEl.textContent = json.body; }
                } else {
                    resultEl.textContent = '錯誤：' + json.errorMessage;
                }
            } catch (e) {
                resultEl.textContent = '呼叫失敗：' + e;
            }
        });

        // ---------- Submit ----------
        document.getElementById('editForm').addEventListener('submit', (ev) => {
            const headers = {};
            document.querySelectorAll('.header-row').forEach(row => {
                const k = row.querySelector('.header-key').value.trim();
                const v = row.querySelector('.header-value').value;
                if (k) headers[k] = v;
            });

            const fields = {};
            document.querySelectorAll('.field-mapping-input').forEach(i => {
                if (!i.value.trim()) return;
                fields[i.dataset.field] = i.value.trim();
            });

            const collections = Array.from(document.querySelectorAll('.collection-box')).map(box => {
                const columns = {};
                box.querySelectorAll('.collection-column-input').forEach(i => {
                    if (!i.value.trim()) return;
                    columns[i.dataset.column] = i.value.trim();
                });
                return {
                    name: box.dataset.name,
                    path: box.querySelector('.collection-path').value.trim(),
                    columns: columns,
                    spread: {
                        from: box.querySelector('.spread-from').value.trim(),
                        prefix: box.querySelector('.spread-prefix').value.trim(),
                        max: parseInt(box.querySelector('.spread-max').value, 10) || 0
                    }
                };
            });

            const images = {};
            document.querySelectorAll('.image-mapping-input').forEach(i => {
                if (!i.value.trim()) return;
                const typeSelect = document.querySelector('.image-mapping-type[data-field="' + i.dataset.field + '"]');
                images[i.dataset.field] = { path: i.value.trim(), sourceType: typeSelect ? typeSelect.value : 'auto' };
            });

            const sourceType = document.getElementById('f-sourceType').value;
            const staticJson = document.getElementById('f-staticJson').value.trim();
            document.getElementById('staticJsonError').textContent = '';
            if (sourceType === 'paste') {
                try {
                    if (staticJson) JSON.parse(staticJson);
                } catch (e) {
                    ev.preventDefault();
                    document.getElementById('staticJsonError').textContent = '貼上的內容不是有效的 JSON：' + e.message;
                    return;
                }
            }

            const config = {
                code: document.getElementById('f-code').value.trim(),
                name: document.getElementById('f-name').value.trim(),
                templateFile: window.__selectedTemplateFile || initialConfig.templateFile || '',
                templateSheet: document.getElementById('f-templateSheet').value || '0',
                dataSource: {
                    type: sourceType,
                    url: document.getElementById('f-url').value.trim(),
                    method: document.getElementById('f-method').value,
                    headers: headers,
                    timeoutSec: parseInt(document.getElementById('f-timeout').value, 10) || 30,
                    staticJson: staticJson
                },
                parameters: getParameters(),
                mapping: {
                    root: document.getElementById('f-root').value.trim() || '$',
                    fields: fields,
                    collections: collections,
                    images: images
                },
                subReports: getSubReports()
            };

            if (!config.templateFile) {
                ev.preventDefault();
                alert('請先上傳或選擇一份範本 xlsx。');
                return;
            }

            document.getElementById('configJson').value = JSON.stringify(config);
        });

        // ---------- Init ----------
        (function init() {
            document.getElementById('f-code').value = initialConfig.code || '';
            document.getElementById('f-name').value = initialConfig.name || '';
            document.getElementById('f-sourceType').value = (initialConfig.dataSource && initialConfig.dataSource.type) || 'url';
            document.getElementById('f-url').value = (initialConfig.dataSource && initialConfig.dataSource.url) || '';
            document.getElementById('f-method').value = (initialConfig.dataSource && initialConfig.dataSource.method) || 'GET';
            document.getElementById('f-timeout').value = (initialConfig.dataSource && initialConfig.dataSource.timeoutSec) || 30;
            document.getElementById('f-staticJson').value = (initialConfig.dataSource && initialConfig.dataSource.staticJson) || '';
            updateSourceTypeVisibility();
            document.getElementById('f-root').value = (initialConfig.mapping && initialConfig.mapping.root) || '$.data';

            if (initialConfig.templateFile) {
                window.__selectedTemplateFile = initialConfig.templateFile;
                document.getElementById('templateFileBadge').textContent = initialConfig.templateFile;
                document.getElementById('f-templateSelect').value = initialConfig.templateFile;
                updateDownloadLink(initialConfig.templateFile);
            }
            populateSheetSelect(document.getElementById('f-templateSheet'), sheetNames, initialConfig.templateSheet);

            const hdrs = (initialConfig.dataSource && initialConfig.dataSource.headers) || {};
            Object.keys(hdrs).forEach(k => addHeaderRow(k, hdrs[k]));

            const parms = initialConfig.parameters || [];
            if (parms.length > 0) {
                parms.forEach(p => addParamRow(p.key, p.label, p.type, p.required));
            } 
            // else {
            //     addParamRow('docNo', '單據號', 'string', true);
            // }

            applyScanResult(currentScanResult, initialConfig.mapping);

            const subReportsArea = document.getElementById('subReportsArea');
            (initialConfig.subReports || []).forEach(sr => {
                subReportsArea.appendChild(createSubReportCard(sr));
            });
        })();
    </script>
}

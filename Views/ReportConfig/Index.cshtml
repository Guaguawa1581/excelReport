@model List<ReportConfig>
@{
    ViewData["Title"] = "報表設定管理";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>報表設定管理</h1>
    <a class="btn btn-primary" asp-controller="ReportConfig" asp-action="Edit" asp-route-code="new">新增設定</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<table class="table table-bordered table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>代碼</th>
            <th>名稱</th>
            <th>範本檔</th>
            <th>參數</th>
            <th style="width: 260px">操作</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var config in Model)
        {
            <tr>
                <td><code>@config.Code</code></td>
                <td>@config.Name</td>
                <td>@config.TemplateFile</td>
                <td>@string.Join("、", config.Parameters.Select(p => p.Label))</td>
                <td>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-code="@config.Code">編輯</a>
                    <form method="post" asp-action="Copy" asp-route-code="@config.Code" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-secondary">複製</button>
                    </form>
                    <form method="post" asp-action="Delete" asp-route-code="@config.Code" class="d-inline"
                          onsubmit="return confirm('確定要刪除設定「@config.Code」嗎？');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger">刪除</button>
                    </form>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="5" class="text-center text-muted">尚無任何報表設定</td></tr>
        }
    </tbody>
</table>
